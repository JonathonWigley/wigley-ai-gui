{
  "name": "wigley-ai-gui",
  "productName": "wigley-ai-gui",
  "version": "1.11.0",
  "private": true,
  "description": "A desktop app for running and answering coding-agent sessions.",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Jonathon Wigley"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "selftest": "node scripts/selftest.mts",
    "package": "electron-forge package",
    "lint": "node scripts/check-layers.mts && node scripts/check-styles.mts && node scripts/check-changelog.mts && node scripts/check-boundary.mts && oxlint && oxfmt --check",
    "lint:changelog": "node scripts/check-changelog.mts",
    "lint:boundary": "node scripts/check-boundary.mts",
    "changelog:release": "node scripts/changelog-release.mts",
    "lint:fix": "oxlint --fix && oxfmt --write && node scripts/check-layers.mts && node scripts/check-styles.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "drive": "node scripts/drive.mts",
    "install-app": "node scripts/install-app.mts",
    "create-signing-identity": "node scripts/create-signing-identity.mts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "electron": "44.9.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/server": "2.3.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@vscode/codicons": "0.0.46-24",
    "codemirror": "^6.0.2",
    "fabric": "7.4.0",
    "fzf": "0.5.2",
    "markdown-it": "15.0.3"
  }
}
